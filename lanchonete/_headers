# Cabeçalhos de segurança aplicados pelo Cloudflare a todas as páginas e arquivos do site.
# connect-src libera só o serviço de rotas usado no cálculo da taxa de entrega.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://router.project-osrm.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), clipboard-read=(self), camera=(), microphone=(), payment=(), usb=()
